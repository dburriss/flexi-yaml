<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>netstandard2.0;net10.0</TargetFrameworks>
    <IsPackable>true</IsPackable>
    <PackageId>Flexi.Yaml</PackageId>
    <Description>A dependency-free YAML document API, shaped like FSharp.Data's JsonValue: a discriminated union DU you can pattern match, Parse/Load, a `?` dynamic operator and AsInteger()-style accessors.</Description>
    <Version>0.2.0</Version>
    <PackageReleaseNotes>`YamlParsed.NumberText`: the original source text of every `Number` and `Float` node (`1.10`, `1.0`, `1e3`, `0x1F`), keyed by JSON Pointer, from `ParseWithMetadata`, `TryParseWithMetadata` and `ParseMultipleWithMetadata`.
Adding the `NumberText` field to the `YamlParsed` record is source-breaking for code that constructs a `YamlParsed` literal, so the next release is 0.2.0.
Retargeted `net8.0` to `net10.0`: the library now targets `netstandard2.0` and `net10.0`, and the tests and Fable project target `net10.0`. `IsAotCompatible` is now set only for the `net10.0` target.</PackageReleaseNotes>
    <Authors>Devon Burriss</Authors>
    <Title>Flexi.Yaml</Title>
    <Copyright>Copyright © 2026 Devon Burriss</Copyright>
    <PackageProjectUrl>https://github.com/dburriss/flexi-yaml</PackageProjectUrl>
    <RepositoryUrl>https://github.com/dburriss/flexi-yaml</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageTags>fsharp yaml parser serializer</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <IsAotCompatible Condition="'$(TargetFramework)' != 'netstandard2.0'">true</IsAotCompatible>
  </PropertyGroup>
  <ItemGroup>
    <None Include="..\..\NUGET.md" Pack="true" PackagePath="README.md" Condition="Exists('..\..\NUGET.md')" />
  </ItemGroup>
  <ItemGroup>
    <Compile Include="YamlValue.fs" />
    <Compile Include="YamlPortable.fs" />
    <Compile Include="YamlReader.fs" />
    <Compile Include="YamlScalar.fs" />
    <Compile Include="YamlParser.fs" />
    <Compile Include="YamlPositions.fs" />
    <Compile Include="YamlEmitter.fs" />
    <Compile Include="YamlExtensions.fs" />
    <Compile Include="YamlBuilders.fs" />
    <Compile Include="AssemblyInfo.fs" />
  </ItemGroup>
  <!-- Fable compiles from source: ship every .fs plus this project file under fable/ -->
  <ItemGroup>
    <Content Include="*.fsproj" Pack="true" PackagePath="fable/" />
    <Content Include="@(Compile)" Pack="true" PackagePath="fable/" />
  </ItemGroup>
</Project>